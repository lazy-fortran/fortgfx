#!/bin/sh
# The runner has no GPU: the render test draws through Mesa's software Vulkan
# driver (lavapipe) from conda-forge and must find a device.
set -eu
version=2.10.0-0
root=${TMPDIR:-/tmp}/fortgfx-deps-$version
if [ ! -e "$root/env/share/vulkan/icd.d/lvp_icd.x86_64.json" ]; then
    mkdir -p "$root"
    curl -fsSL -o "$root/micromamba" \
        "https://github.com/mamba-org/micromamba-releases/releases/download/$version/micromamba-linux-64"
    chmod 755 "$root/micromamba"
    MAMBA_ROOT_PREFIX=$root/mamba "$root/micromamba" create -y -q -p "$root/env" \
        -c conda-forge mesa-lavapipe libvulkan-loader
fi
export LD_LIBRARY_PATH="$root/env/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export VK_DRIVER_FILES="$root/env/share/vulkan/icd.d/lvp_icd.x86_64.json"
export FORTGFX_REQUIRE_GPU=1
fo test "$@"
